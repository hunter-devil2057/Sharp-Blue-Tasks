                <mxCell id="h8CI2GH8gT2MhxuCCnwU-65" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;spacing=0;" value="&lt;div style=&quot;line-height: 80%;&quot;&gt;&lt;h1 style=&quot;margin-top: 0px; line-height: 60%;&quot;&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent; font-weight: normal; line-height: 60%;&quot;&gt;This is the architecture of &lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent; line-height: 60%;&quot;&gt;Multi-model RAG System&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent; font-weight: normal; line-height: 60%;&quot;&gt;.&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify; color: rgb(63, 63, 63); scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20);&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20); line-height: 60%;&quot;&gt;CLIP (Contrastive Language–Image Pre-training)&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;&lt;font style=&quot;line-height: 60%;&quot;&gt;model is trained with images and text-mapped datasets, available in HuggingFace&lt;/font&gt;&lt;/span&gt;.&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify; color: rgb(63, 63, 63); scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20);&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;&lt;font style=&quot;&quot;&gt;converts both images and text into embeddings in a shared vector space&lt;/font&gt;&lt;/span&gt;.&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify; color: rgb(63, 63, 63); scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20);&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Shared Vector Space: &lt;span style=&quot;font-weight: normal;&quot;&gt;represents the image and text embeddings in same mathematical space (co-ordinate system) .&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;text-align: justify; color: rgb(63, 63, 63); scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20);&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;processes both images and texts: images using &lt;/span&gt;Vision Transformer &lt;span style=&quot;font-weight: normal;&quot;&gt;and text using &lt;/span&gt;TextTransformer/Transformer&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/h1&gt;&lt;/div&gt;" vertex="1">
